{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_codegraph_prompt.py\"",
            "timeout": 10,
            "statusMessage": "codegraph-plugin: 检测 .codegraph/ 并注入官方提示词…"
          }
        ]
      }
    ]
  }
}